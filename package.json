{
  "name": "project-agent-init",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable agent instructions and a project initialization skill",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "install:skill": "node scripts/install.mjs",
    "update:skill": "node scripts/update.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
